DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=factugest
SESSION_SECRET=cambia-esta-clave-secreta

DIAN_PROVEEDOR=simulado

# Llave con la que FactuGest se factura a si mismo la mensualidad de sus clientes.
# La genero seed_proveedor.py; si se pierde, se rota desde Plataforma > Clientes API.
FACTUGEST_URL=http://127.0.0.1:8000
FACTUGEST_API_KEY=fg_live_5bcbd792.xHqTIPxfKZOOtePesdOOQxyTz5JTl3E5

# Correo saliente con el que se le manda el documento al comprador. Sin esto la
# emision funciona igual: el intento queda anotado como omitido en los eventos del
# documento, en lugar de tumbar la factura por un servidor de correo apagado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=facturacion@factugest.co
SMTP_TLS=si

# Cierre de sesion por inactividad. Trabajar renueva el reloj en cada peticion;
# lo que cierra la sesion es dejar de trabajar. El aviso aparece antes, para no
# perder una factura a medio llenar.
SESION_MINUTOS=30
SESION_AVISO_MINUTOS=2

# En produccion, con HTTPS, la cookie de sesion no debe viajar en claro.
COOKIES_SEGURAS=no
