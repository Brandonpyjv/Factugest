DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=factugest
SESSION_SECRET=cambia-esta-clave-secreta

# Proveedor con el que se transmite a la DIAN.
#   simulado -> valida el documento y lo da por aceptado, sin salir a ninguna parte
#   factus   -> proveedor real (pendiente, tarea 7.2)
# En desarrollo se deja en simulado para no gastar cupo real en pruebas.
DIAN_PROVEEDOR=simulado

# FactuGest emite la mensualidad de sus clientes llamando a su propia API, con una
# llave como la de cualquier otro integrado: si el producto no sirve para facturarnos
# a nosotros, no sirve. La genera `python seed_proveedor.py` y se muestra una sola
# vez; si se pierde, se rota desde el panel en Plataforma > Clientes API.
FACTUGEST_URL=http://127.0.0.1:8000
FACTUGEST_API_KEY=
